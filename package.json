{
  "name": "dsh-service-board",
  "version": "0.3.0",
  "description": "DSH 服务面板：查看由哪个对话（Agent 会话）启动了哪些服务，按会话分组、三态健康探测 + HTTP 码、启动时间/运行时长、礼貌停止、实时日志分栏与原地重启。含对上游 dsh-process-board 的若干修复（重启后 no-log、扫描器同名启动器误合并、面板抢占输入框焦点）。A docked DSH service panel: which conversation started which service, with uptime, tri-state health, live logs and restart replay.",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "process-manager",
    "service-dashboard",
    "service-panel",
    "devtools"
  ],
  "main": "src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./src/client/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fanjinduo111/dsh-service-board.git"
  },
  "homepage": "https://github.com/fanjinduo111/dsh-service-board#readme",
  "bugs": {
    "url": "https://github.com/fanjinduo111/dsh-service-board/issues"
  },
  "author": "dsh-service-board contributors",
  "license": "MIT",
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "puppeteer-core": "^25.12.0"
  }
}
